fifo_10_cons_buff_0 = .;
. += 0x6000;
. = 0x76400;
fifo_10_cons_buff_1 = .;
. += 0x6000;
  .bss : { *(.bss*) } > data
}
INPUT(external0.o)
PROVIDE(main = core_2_2);
