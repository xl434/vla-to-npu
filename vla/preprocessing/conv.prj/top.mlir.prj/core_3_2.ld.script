fifo_20_14_cons_buff_1 = .;
. += 0x200;
. = 0x50400;
fifo_10_cons_buff_0 = .;
. += 0x2000;
. = 0x52400;
fifo_10_cons_buff_1 = .;
. += 0x2000;
. = 0x64800;
fifo_38_buff_0 = .;
. += 0x20;
. = 0x64820;
fifo_38_buff_1 = .;
. += 0x20;
. = 0x64400;
fifo_20_7_cons_buff_0 = .;
. += 0x200;
. = 0x64600;
fifo_20_7_cons_buff_1 = .;
. += 0x200;
. = 0x60400;
fifo_16_cons_buff_0 = .;
. += 0x2000;
. = 0x62400;
fifo_16_cons_buff_1 = .;
. += 0x2000;
. = 0x74800;
fifo_37_buff_0 = .;
