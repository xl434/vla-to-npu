
MEMORY
{
   program (RX) : ORIGIN = 0, LENGTH = 0x0020000
   data (!RX) : ORIGIN = 0x74840, LENGTH = 0xB7C0
}
ENTRY(__start)
SECTIONS
{
  . = 0x0;
  .text : {
     /* the __start symbol has to come at address zero. */
     *crt0.o(.text*)
     _ctors_start = .;
     _init_array_start = .;
     KEEP(SORT(*.init_array))
     _ctors_end = .;
     _init_array_end = .;
     _dtors_start = .;
     _dtors_end = .;
     *(.text*)
  } > program
  .data : {
     *(.data*)
     *(.rodata*)
  } > data
  .comment : {
     *(.comment*)
  }
  .symtab : {
     *(.symtab)
  }
  .shstrtab : {
     *(.shstrtab)
  }
  .strtab : {
     *(.strtab)
  }

. = 0x70000;
_sp_start_value_DM_stack = .;
. += 0x400; /* stack */
. = 0x44800;
fifo_22_buff_0 = .;
. += 0x20;
. = 0x44820;
fifo_22_buff_1 = .;
. += 0x20;
. = 0x44400;
fifo_20_12_cons_buff_0 = .;
. += 0x200;
. = 0x44600;
fifo_20_12_cons_buff_1 = .;
. += 0x200;
. = 0x40400;
fifo_0_cons_buff_0 = .;
. += 0x2000;
. = 0x42400;
fifo_0_cons_buff_1 = .;
. += 0x2000;
/* No tile with memory exists to the west. */
. = 0x50000;
. += 0x10000;
. = 0x64800;
fifo_24_buff_0 = .;
. += 0x20;
. = 0x64820;
fifo_24_buff_1 = .;
. += 0x20;
. = 0x64400;
fifo_20_4_cons_buff_0 = .;
. += 0x200;
. = 0x64600;
fifo_20_4_cons_buff_1 = .;
. += 0x200;
. = 0x60400;
fifo_2_cons_buff_0 = .;
. += 0x2000;
. = 0x62400;
fifo_2_cons_buff_1 = .;
. += 0x2000;
. = 0x74800;
fifo_23_buff_0 = .;
. += 0x20;
. = 0x74820;
fifo_23_buff_1 = .;
. += 0x20;
. = 0x74400;
fifo_20_9_cons_buff_0 = .;
